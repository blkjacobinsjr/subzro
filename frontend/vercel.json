{
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/md",
      "destination": "/api/md"
    },
    {
      "source": "/api/md/(.*)",
      "destination": "/api/md?path=$1"
    },
    {
      "source": "/((?!api/|llms\\.txt|llms-full\\.txt|ai\\.txt|robots\\.txt|sitemap\\.xml|.*\\.md).*)",
      "destination": "/"
    }
  ],
  "headers": [
    {
      "source": "/index.md",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        },
        {
          "key": "Link",
          "value": "<https://subzro.vercel.app>; rel=\"canonical\""
        }
      ]
    },
    {
      "source": "/pricing.md",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        },
        {
          "key": "Link",
          "value": "<https://subzro.vercel.app/pricing>; rel=\"canonical\""
        }
      ]
    },
    {
      "source": "/privacy.md",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        },
        {
          "key": "Link",
          "value": "<https://subzro.vercel.app/privacy>; rel=\"canonical\""
        }
      ]
    },
    {
      "source": "/privacy-policy.md",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        },
        {
          "key": "Link",
          "value": "<https://subzro.vercel.app/privacy>; rel=\"canonical\""
        }
      ]
    },
    {
      "source": "/terms.md",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        },
        {
          "key": "Link",
          "value": "<https://subzro.vercel.app/terms>; rel=\"canonical\""
        }
      ]
    },
    {
      "source": "/terms-and-conditions.md",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        },
        {
          "key": "Link",
          "value": "<https://subzro.vercel.app/terms>; rel=\"canonical\""
        }
      ]
    },
    {
      "source": "/impressum.md",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        },
        {
          "key": "Link",
          "value": "<https://subzro.vercel.app/impressum>; rel=\"canonical\""
        }
      ]
    },
    {
      "source": "/imprint.md",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        },
        {
          "key": "Link",
          "value": "<https://subzro.vercel.app/impressum>; rel=\"canonical\""
        }
      ]
    },
    {
      "source": "/refund.md",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        },
        {
          "key": "Link",
          "value": "<https://subzro.vercel.app/refund>; rel=\"canonical\""
        }
      ]
    },
    {
      "source": "/refund-policy.md",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        },
        {
          "key": "Link",
          "value": "<https://subzro.vercel.app/refund>; rel=\"canonical\""
        }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/llms-full.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/ai.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "script-src 'self' 'wasm-unsafe-eval' 'inline-speculation-rules' blob: https://js.clerk.com https://*.clerk.com https://*.clerk.dev https://*.clerk.accounts.dev https://*.clerk.accounts.com https://cdn.paddle.com https://*.paddle.com; script-src-elem 'self' 'wasm-unsafe-eval' 'inline-speculation-rules' blob: https://js.clerk.com https://*.clerk.com https://*.clerk.dev https://*.clerk.accounts.dev https://*.clerk.accounts.com https://cdn.paddle.com https://*.paddle.com; worker-src 'self' blob:; child-src 'self' blob: https://*.paddle.com; frame-src 'self' https://*.paddle.com;"
        }
      ]
    }
  ]
}
